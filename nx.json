{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "maxCacheSize": "5GB",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/build/**/*",
      "!{projectRoot}/app/build/**/*",
      "!{projectRoot}/.gradle/**/*",
      "!{projectRoot}/.nx/**/*",
      "!{projectRoot}/.husky/**/*",
      "!{projectRoot}/.superpowers/**/*",
      "!{projectRoot}/docs/superpowers/**/*",
      "!{projectRoot}/*.apk",
      "!{projectRoot}/*.idsig",
      "!{projectRoot}/*.sha256",
      "!{projectRoot}/release.keystore",
      "!{projectRoot}/**/*.log",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/app/src/test*/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/project.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/biome.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["production"]
    },
    "test": {
      "cache": true,
      "inputs": ["default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default"]
    },
    "lint:secrets": {
      "cache": true,
      "inputs": ["default"]
    },
    "format:check": {
      "cache": true,
      "inputs": ["default"]
    }
  },
  "analytics": false
}
