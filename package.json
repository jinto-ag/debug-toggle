{
  "name": "@jinto-ag/debug-toggle",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "nx run @jinto-ag/debug-toggle:build",
    "test": "nx run @jinto-ag/debug-toggle:test",
    "test:e2e": "nx run @jinto-ag/debug-toggle:test:e2e",
    "lint": "nx run @jinto-ag/debug-toggle:lint",
    "lint:secrets": "nx run @jinto-ag/debug-toggle:lint:secrets",
